# 이 파일을 terraform.tfvars 로 복사한 뒤 값을 채우세요. (terraform.tfvars 는 git에 커밋하지 마세요)

# TURN 비밀번호 (필수)
turn_password = "여기에_강한_비밀번호"

# SSH 접속이 필요하면 미리 만든 키페어 이름을 넣으세요 (선택)
# key_name = "my-keypair"

# 보안상 본인 공인 IP로 제한 권장 (https://whatismyip.com 에서 확인)
# ssh_cidr = "1.2.3.4/32"

# 필요 시 오버라이드 (기본값으로도 동작)
# region        = "ap-northeast-2"
# instance_type = "t4g.nano"
# turn_user     = "caestro"
# turn_realm    = "caestro"
