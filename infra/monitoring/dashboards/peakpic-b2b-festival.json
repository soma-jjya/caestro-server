{
 "uid": "peakpic-b2b-festival",
 "title": "PeakPic B2B 축제 서버",
 "tags": [
  "peakpic",
  "b2b"
 ],
 "timezone": "Asia/Seoul",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "데이터 소스",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   },
   {
    "name": "slug",
    "label": "축제",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "query": {
     "query": "label_values(up{job=\"peakpic-b2b-festival\"}, slug)",
     "refId": "slug"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "수집 상태 (1 = 정상)",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "min(up{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "초당 요청",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[1m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "5xx 비율",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.001
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{job=\"peakpic-b2b-festival\",slug=~\"$slug\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[5m])),1e-9)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "힙 사용률",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(jvm_memory_used_bytes{job=\"peakpic-b2b-festival\",slug=~\"$slug\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"peakpic-b2b-festival\",slug=~\"$slug\",area=\"heap\"})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "초당 요청 (상태 코드별)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "평균·최대 응답 시간 (경로별)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[5m]))",
     "legendFormat": "평균 {{uri}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (uri) (http_server_requests_seconds_max{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "최대 {{uri}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "B2B 작업 p95 (생성·조회·업로드 등)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(b2b_operation_seconds_bucket{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[5m])))",
     "legendFormat": "{{operation}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "B2B 작업 처리율 (결과별)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (operation, outcome) (rate(b2b_operation_seconds_count{job=\"peakpic-b2b-festival\",slug=~\"$slug\"}[5m]))",
     "legendFormat": "{{operation}} / {{outcome}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "JVM 힙 (사용 / 최대)",
   "description": "ALB 가 인스턴스 하나에만 보내 서버 한 대 값이다. 서버별은 CloudWatch PeakPicB2B/Host",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(jvm_memory_used_bytes{job=\"peakpic-b2b-festival\",slug=~\"$slug\",area=\"heap\"})",
     "legendFormat": "사용"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(jvm_memory_max_bytes{job=\"peakpic-b2b-festival\",slug=~\"$slug\",area=\"heap\"})",
     "legendFormat": "최대"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "GC 멈춤 최대",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(jvm_gc_pause_seconds_max{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "최대"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "DB 연결 (풀 15)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 20
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(hikaricp_connections_active{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "사용"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(hikaricp_connections_pending{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "대기"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(hikaricp_connections_max{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "최대"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "톰캣 스레드 사용",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 28
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(tomcat_threads_busy_threads{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "바쁨"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(tomcat_threads_config_max_threads{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "최대"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "앱 CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 28
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(process_cpu_usage{job=\"peakpic-b2b-festival\",slug=~\"$slug\"})",
     "legendFormat": "process"
    }
   ]
  }
 ],
 "description": "축제 전용 서버(peakpic-b2b-server) 앱 지표. 잡 peakpic-b2b-festival, 축제는 slug 로 고른다. 서버 메모리·CPU·ALB 는 CloudWatch, 알림은 Discord"
}
